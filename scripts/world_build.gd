const HOUSE := Rect2i(9, 3, 9, 6)
const HOUSE_TILESET_RECT := Rect2i(20, 10, 9, 6)
const FARM := Rect2i(6, 21, 12, 8)
const POND := Rect2i(4, 30, 9, 6)


func _ready() -> void:
	_build_ground()
	_build_soil()
	_build_decor()
	_build_house()
	print("[world] built: ground=%d soil=%d decor=%d" % [GROUND.size(), SOIL.size(), DECOR.size()])


func _ts() -> TileSet:
	return load(TILESET_PATH)


func _decode(v: Vector3i) -> Vector2i:
	return Vector2i(v.z / 64, v.z % 64)


func _fill(layer: TileMapLayer, data: Array, source_id: int) -> void:
	for v in data:
		var c: Vector3i = v
		layer.set_cell(Vector2i(c.x, c.y), source_id, _decode(c))


func _build_ground() -> void:
	var layer: TileMapLayer = $GroundLayer
	layer.tile_set = _ts()
	_fill(layer, GROUND, 0)


func _build_soil() -> void:
	var layer: TileMapLayer = $FarmSoilLayer
	layer.tile_set = _ts()
	_fill(layer, SOIL, 0)


func _build_decor() -> void:
	var layer: TileMapLayer = $DecorLayer
	layer.tile_set = _ts()
	_fill(layer, DECOR, 0)


func _build_house() -> void:
	var tex: Texture2D = load("res://assets/tileset/spr_tileset_sunnysideworld_16px.png")
	var at := AtlasTexture.new()
	at.atlas = tex
	at.region = Rect2(HOUSE_TILESET_RECT.position * 16, HOUSE_TILESET_RECT.size * 16)
	var s := Sprite2D.new()
	s.name = "HouseSprite"
	s.texture = at
	s.centered = false
	s.position = Vector2(HOUSE.position * 16)
	add_child(s)

